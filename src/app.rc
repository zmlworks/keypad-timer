#pragma code_page(65001)
#include <windows.h>

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 0,5,1,0
PRODUCTVERSION 0,5,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104b0"
    BEGIN
      VALUE "CompanyName", "zmlworks"
      VALUE "ProductName", "Keypad Timer"
      VALUE "FileDescription", "Keypad Timer (キーパッドタイマー)"
      VALUE "FileVersion", "0.5.1"
      VALUE "ProductVersion", "0.5.1"
      VALUE "LegalCopyright", "Copyright (c) 2026 zmlworks, MIT License"
      VALUE "OriginalFilename", "KeypadTimer.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
